# Par défaut, l'agent utilise Ollama en local (gratuit, illimité) — installe-le
# depuis https://ollama.com/download puis lance : ollama pull qwen3:4b-instruct
# Rien à renseigner ci-dessous pour ce cas d'usage.

# Optionnel : utiliser un fournisseur cloud (OpenRouter, etc.) à la place.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=openrouter/free

# Optionnel : changer le modèle Ollama local (doit être déjà "pull" au préalable).
# LLM_MODEL=llama3.1:8b
