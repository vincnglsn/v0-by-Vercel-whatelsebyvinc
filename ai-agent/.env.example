LLM_API_KEY=sk-or-v1-...

# Par défaut, l'agent utilise OpenRouter (LLM_BASE_URL par défaut :
# https://openrouter.ai/api/v1, LLM_MODEL par défaut : openrouter/free).

# Optionnel : utiliser Ollama en local à la place (gratuit, illimité, mais
# demande une machine avec assez de CPU/RAM/GPU — a fait planter un PC modeste).
# Installe-le depuis https://ollama.com/download, lance :
#   ollama pull qwen3:4b-instruct
# puis :
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b-instruct
# (LLM_API_KEY inutile dans ce cas, Ollama ne vérifie pas de clé)

# Optionnel : un autre fournisseur cloud compatible OpenAI (Gemini, un gateway
# comme OmniRoute, etc.) — change LLM_BASE_URL / LLM_MODEL en conséquence.
